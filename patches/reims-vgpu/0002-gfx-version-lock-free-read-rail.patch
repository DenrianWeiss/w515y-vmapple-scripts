+/// Offsets whose `gfx_read` values are compile-time device constants.
+///
+/// Unlike 0x1034 (negotiated, published through `version_live`) these never
+/// change, so the lock-busy read fallback is *seeded* with them at create and
+/// reset rather than given a live rail: one read per offset from the device's
+/// own MMIO layer keeps the values single-sourced, and the cache the seed lands
+/// in is exactly the fallback a contended read already takes. The mutable EFI
+/// registers (mode select, framebuffer base/length/...) stay lock-gated - their
+/// values are device state, and a stale answer there is the cache's documented
+/// risk, not a matching-time one.
+const CONSTANT_GFX_READS: [u64; 5] = [
+    crate::model::GFX_REG_EFI_MODE_COUNT,
+    crate::model::GFX_REG_EFI_MODE_SIZE,
+    crate::model::GFX_REG_EFI_STRIDE_ALIGN,
+    crate::model::GFX_REG_EFI_DISPLAY_PORTS,
+    crate::model::GFX_REG_EFI_BUILTIN_CONNECTED,
+];
+
+/// Seed `cache` with [`CONSTANT_GFX_READS`], read from `device` while the
+/// caller holds its lock (create, reset). Size 4 only: the firmware probes
+/// these as u32, and a u64 read of a u32-sized EFI descriptor is not a form
+/// the register's layout defines.
+fn seed_constant_gfx_reads(cache: &mut HashMap<(u64, u32), u64>, device: &mut Device) {
+    for offset in CONSTANT_GFX_READS {
+        cache.insert((offset, 4), device.gfx_read(offset, 4));
+    }
+}
