+/// The protocol-version register (0x1034) must answer the negotiated value
+/// even while the drain worker owns the device lock. The 2026-09-17 stall:
+/// the guest's first matching read hit a busy lock, the read cache had never
+/// held the register, and the read returned 0 - AppleParavirtGPU matched
+/// against version 0, switched its whole feature set off, and never started.
+#[test]
+fn version_read_is_live_while_device_lock_held() {
+    let id = device_create(None, PAGE_SHIFT_ARM64E).expect("create");
+    // Negotiate before taking the lock, as the guest does.
+    assert!(device_gfx_write(id, 0x1034, 62, 4));
+    assert_eq!(device_gfx_read(id, 0x1034, 4), Some(62));
+
+    let slot = device_slot(id).expect("slot");
+    let _drain_guard = slot.inner.lock();
+    assert_eq!(
+        device_gfx_read(id, 0x1034, 4),
+        Some(62),
+        "a contended version read must answer the negotiated value, not a cache-miss zero"
+    );
+    // Constant capability registers are seeded for exactly this contended
+    // path: no live rail, but never a lock-busy zero either.
+    assert_eq!(
+        device_gfx_read(id, crate::model::GFX_REG_EFI_MODE_COUNT, 4),
+        Some(crate::model::EFI_MODE_COUNT as u64),
+    );
+    assert_eq!(
+        device_gfx_read(id, crate::model::GFX_REG_EFI_DISPLAY_PORTS, 4),
+        Some(crate::model::EFI_DISPLAY_PORT_COUNT as u64),
+    );
+    drop(_drain_guard);
+    assert!(device_destroy(id));
+}
+
+/// A reset must leave the constant capability seeds in place: the cache is
+/// cleared, and the reseed runs under the same lock the clear already held.
+#[test]
+fn constant_capability_reads_survive_reset() {
+    let id = device_create(None, PAGE_SHIFT_ARM64E).expect("slot");
+    assert!(device_reset(id));
+    assert!(device_gfx_write(id, 0x1034, 62, 4));
+    let slot = device_slot(id).expect("slot");
+    let _drain_guard = slot.inner.lock();
+    assert_eq!(device_gfx_read(id, 0x1034, 4), Some(62));
+    assert_eq!(
+        device_gfx_read(id, crate::model::GFX_REG_EFI_BUILTIN_CONNECTED, 4),
+        Some(crate::model::EFI_BUILTIN_CONNECTED as u64),
+    );
+    drop(_drain_guard);
+    assert!(device_destroy(id));
+}
