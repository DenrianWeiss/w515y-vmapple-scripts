@@ -237,7 +237,17 @@ static void create_gfx(VMAppleMachineState *vms, MemoryRegion *mem)
      * apple-gfx-mmio (ParavirtualizedGraphics.framework host side, reference)
      * or reims-vgpu-mmio (product: thin C → crates/reims-vgpu Rust staticlib).
      * Sysbus layout: mmio 0/irq 0 = gfx window, mmio 1/irq 1 = IOSurface mapper.
+     *
+     * Neither type may exist in this build (e.g. a Linux build without the
+     * reims-vgpu sibling checkout); the guest does not need the paravirt GPU
+     * to bring up the rest of the platform, so boot headless instead of
+     * dying in qdev_new().
      */
+    if (!object_class_by_name(vms->gfx_device)) {
+        warn_report("vmapple: gfx device '%s' not available in this build; "
+                    "running without a paravirt GPU", vms->gfx_device);
+        return;
+    }
     gfx_dev = qdev_new(vms->gfx_device);
     gfx_dev->id = g_strdup("reims-vgpu-gfx");
     gfx = SYS_BUS_DEVICE(gfx_dev);
