     uint32_t ctxt = (cmd & CMD_IV_CONTEXT_MASK) >> CMD_IV_CONTEXT_SHIFT;
     uint64_t addr = s->fifo[1];
     MemTxResult dma_result;
 
-    if (!has_payload(s, 1)) {
-        qemu_log_mask(LOG_GUEST_ERROR, "%s: No payload\n", __func__);
-        return false;
-    }
-
     if (ctxt >= ARRAY_SIZE(s->iv)) {
         qemu_log_mask(LOG_GUEST_ERROR,
                       "%s: Invalid context. ctxt = %u, allowed: 0..%zu\n",
                       __func__, ctxt, ARRAY_SIZE(s->iv) - 1);
-        return false;
+        return AES_CMD_ERROR;
+    }
+
+    if (!has_payload(s, 1)) {
+        /* wait for payload */
+        return AES_CMD_NEED_MORE;
     }
 
     addr |= ((uint64_t)cmd << 32) & 0xff00000000ULL;
@@ -391,10 +410,10 @@ static bool cmd_store_iv(AESState *s)
     trace_aes_cmd_store_iv(ctxt, addr, s->iv[ctxt].iv[0], s->iv[ctxt].iv[1],
                            s->iv[ctxt].iv[2], s->iv[ctxt].iv[3]);
 
-    return dma_result == MEMTX_OK;
+    return dma_result == MEMTX_OK ? AES_CMD_OK : AES_CMD_ERROR;
 }
 
-static bool cmd_flag(AESState *s)
+static AESCmdResult cmd_flag(AESState *s)
 {
     uint32_t cmd = s->fifo[0];
     uint32_t raise_irq = cmd & CMD_FLAG_RAISE_IRQ_MASK;
@@ -408,13 +427,13 @@ static bool cmd_flag(AESState *s)
 
     trace_aes_cmd_flag(!!raise_irq, s->flag_info);
 
-    return true;
+    return AES_CMD_OK;
 }
 
 static void fifo_process(AESState *s)
 {
     uint32_t cmd = s->fifo[0] >> CMD_SHIFT;
-    bool success = false;
+    AESCmdResult res = AES_CMD_ERROR;
 
     if (!s->fifo_idx) {
         return;
@@ -422,30 +441,47 @@ static void fifo_process(AESState *s)
 
     switch (cmd) {
     case CMD_KEY:
-        success = cmd_key(s);
+        res = cmd_key(s);
         break;
     case CMD_IV:
-        success = cmd_iv(s);
+        res = cmd_iv(s);
         break;
     case CMD_DATA:
-        success = cmd_data(s);
+        res = cmd_data(s);
         break;
     case CMD_STORE_IV:
-        success = cmd_store_iv(s);
+        res = cmd_store_iv(s);
         break;
     case CMD_FLAG:
-        success = cmd_flag(s);
+        res = cmd_flag(s);
         break;
     default:
-        s->irq_status |= REG_IRQ_STATUS_INVALID_CMD;
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: Invalid command 0x%"PRIx32"\n",
+                      __func__, cmd);
+        res = AES_CMD_ERROR;
         break;
     }
 
-    if (success) {
+    switch (res) {
+    case AES_CMD_OK:
         s->fifo_idx = 0;
+        break;
+    case AES_CMD_NEED_MORE:
+        /* Wait for the payload words */
+        break;
+    case AES_CMD_ERROR:
+    default:
+        /*
+         * Drop the failed command so a bad command can't leave a stale
+         * half-eaten command in the FIFO (which would desync every
+         * subsequent command), and surface the failure to the guest.
+         */
+        s->fifo_idx = 0;
+        s->irq_status |= REG_IRQ_STATUS_INVALID_CMD;
+        break;
     }
 
-    trace_aes_fifo_process(cmd, success);
+    trace_aes_fifo_process(cmd, res == AES_CMD_OK);
 }
 
