@@ -462,8 +498,12 @@ static void aes1_write(void *opaque, hwaddr offset, uint64_t val, unsigned size)
         s->irq_enable = val;
         break;
     case REG_FIFO:
-        fifo_append(s, val);
-        fifo_process(s);
+        if (!fifo_append(s, val)) {
+            s->fifo_idx = 0;
+            s->irq_status |= REG_IRQ_STATUS_INVALID_CMD;
+        } else {
+            fifo_process(s);
+        }
         break;
     default:
         qemu_log_mask(LOG_UNIMP,
diff --git a/hw/vmapple/vmapple.c b/hw/vmapple/vmapple.c
index 63714e9bf5..2f4c48a941 100644
--- a/hw/vmapple/vmapple.c
