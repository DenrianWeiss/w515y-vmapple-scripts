     }
 
     src = g_byte_array_sized_new(len);
@@ -306,7 +325,7 @@ static bool cmd_data(AESState *s)
         qemu_log_mask(LOG_GUEST_ERROR, "%s: DMA read of %"PRIu32" bytes "
