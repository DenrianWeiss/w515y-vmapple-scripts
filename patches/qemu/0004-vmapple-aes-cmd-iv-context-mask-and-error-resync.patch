-    uint32_t ctxt_iv = 0;
+    uint32_t ctxt_iv = (cmd & CMD_DATA_IV_CTX_MASK) >> CMD_DATA_IV_CTX_SHIFT;
     uint32_t ctxt_key = (cmd & CMD_DATA_KEY_CTX_MASK) >> CMD_DATA_KEY_CTX_SHIFT;
     uint32_t len = cmd & CMD_DATA_LEN_MASK;
