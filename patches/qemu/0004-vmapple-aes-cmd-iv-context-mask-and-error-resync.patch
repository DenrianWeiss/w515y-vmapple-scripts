@@ -206,7 +218,9 @@ static bool cmd_key(AESState *s)
         s->block_mode = QCRYPTO_CIPHER_MODE_CBC;
         break;
     default:
-        return false;
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: Unsupported block mode\n",
+                      __func__);
+        return AES_CMD_ERROR;
     }
 
     s->is_encrypt = cmd & CMD_KEY_ENCRYPT_MASK;
@@ -222,33 +236,39 @@ static bool cmd_key(AESState *s)
                                      s->is_encrypt ? "en" : "de",
                                      QCryptoCipherMode_str(s->block_mode));
         if (key_len > sizeof(s->key[ctxt].key)) {
-            return false;
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: Unsupported key length %u\n",
+                          __func__, key_len);
+            return AES_CMD_ERROR;
         }
         if (!has_payload(s, key_len / sizeof(uint32_t))) {
             /* wait for payload */
-            qemu_log_mask(LOG_GUEST_ERROR, "%s: No payload\n", __func__);
-            return false;
+            return AES_CMD_NEED_MORE;
         }
         memcpy(&s->key[ctxt].key, &s->fifo[1], key_len);
         s->key[ctxt].key_len = key_len;
     }
 
-    return true;
+    return AES_CMD_OK;
 }
 
-static bool cmd_iv(AESState *s)
+static AESCmdResult cmd_iv(AESState *s)
 {
     uint32_t cmd = s->fifo[0];
     uint32_t ctxt = (cmd & CMD_IV_CONTEXT_MASK) >> CMD_IV_CONTEXT_SHIFT;
 
+    if (ctxt >= ARRAY_SIZE(s->iv)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: Invalid context %u\n",
