+typedef enum AESCmdResult {
+    AES_CMD_OK,
+    AES_CMD_NEED_MORE,   /* incomplete payload: keep the FIFO, wait */
+    AES_CMD_ERROR,       /* unrecoverable: drop the command, raise INVALID_CMD */
+} AESCmdResult;
+
 typedef struct Key {
     uint32_t key_len;
     uint8_t key[32];
@@ -176,14 +182,20 @@ static uint64_t aes1_read(void *opaque, hwaddr offset, unsigned size)
     return res;
 }
 
-static void fifo_append(AESState *s, uint64_t val)
+static bool fifo_append(AESState *s, uint64_t val)
 {
     if (s->fifo_idx == MAX_FIFO_SIZE) {
-        /* Exceeded the FIFO. Bail out */
-        return;
+        /*
+         * The FIFO can't hold another word and the pending command can
+         * never complete (its payload exceeds the FIFO). Drop the command
+         * and tell the guest instead of silently discarding words, which
+         * would desync the command stream.
+         */
+        return false;
     }
 
     s->fifo[s->fifo_idx++] = val;
+    return true;
 }
 
 static bool has_payload(AESState *s, uint32_t elems)
@@ -191,7 +203,7 @@ static bool has_payload(AESState *s, uint32_t elems)
     return s->fifo_idx >= elems + 1;
