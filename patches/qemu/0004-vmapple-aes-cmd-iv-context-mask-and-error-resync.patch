-        return false;
+        return AES_CMD_ERROR;
     }
     cipher = qcrypto_cipher_new(alg, s->block_mode,
                                 s->key[ctxt_key].key,
@@ -331,24 +350,24 @@ static bool cmd_data(AESState *s)
