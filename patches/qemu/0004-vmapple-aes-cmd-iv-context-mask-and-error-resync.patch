-#define CMD_IV_CONTEXT_MASK      (0x3 << CMD_KEY_CONTEXT_SHIFT)
+#define CMD_IV_CONTEXT_MASK      (0x3 << CMD_IV_CONTEXT_SHIFT)
 #define CMD_DSB           0x3
 #define CMD_SKG           0x4
 #define CMD_DATA          0x5
@@ -89,6 +89,12 @@ static const uint32_t key_lens[CMD_KEY_KEY_LEN_NUM] = {
     [3] = 64,
